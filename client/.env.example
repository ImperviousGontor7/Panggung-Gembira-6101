# Local development environment — copy to .env and edit as needed.
NODE_ENV=development
HOST=0.0.0.0
PORT=5001

# Matches docker-compose.yml (database name: impervious).
DATABASE_URL=postgresql://postgres:password@localhost:5432/impervious?schema=public

API_URL=http://localhost:5001/api
CLIENT_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174

# Use separate random values outside local development.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STORAGE_PROVIDER=local
UPLOAD_MAX_SIZE=10485760
LOG_LEVEL=info

# Optional Redis settings. The core API can be started without Redis unless a Redis-backed module is used.
REDIS_URL=redis://127.0.0.1:6379
