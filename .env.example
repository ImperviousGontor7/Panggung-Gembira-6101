# Impervious Generation — local backend configuration
# Copy this file to .env and set values for your machine.

NODE_ENV=development
HOST=0.0.0.0
PORT=5001

# PostgreSQL: update username, password, host and database name.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/impervious_db?schema=public"

# Use different random values in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
API_URL=http://localhost:5001/api

STORAGE_PROVIDER=local
UPLOAD_MAX_SIZE=10485760
LOG_LEVEL=debug
REDIS_URL=redis://127.0.0.1:6379
